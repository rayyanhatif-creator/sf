/* =========================
   AUTH
========================= */

.auth-page{
    min-height:calc(100vh - 75px);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:40px 20px;
}

.auth-card{
    width:100%;
    max-width:520px;
    background:#fffdfa;
    padding:40px;
    border-radius:28px;
    border:1px solid #e8e0d5;
    box-shadow:0 20px 60px rgba(80,65,50,.07);
}

.auth-card h1{
    margin-bottom:10px;
}

.auth-card p{
    color:#82766a;
    margin-bottom:25px;
    line-height:1.8;
}

.auth-card input,
.auth-card select,
.auth-card textarea{
    width:100%;
    padding:16px;
    margin-bottom:13px;
    border:1px solid #e3dbd0;
    border-radius:14px;
    background:#faf8f4;
    outline:none;
    font-size:15px;
}

.auth-card textarea{
    min-height:120px;
    resize:vertical;
}

.main-btn{
    display:block;
    width:100%;
    padding:15px;
    border:0;
    border-radius:14px;
    background:#756653;
    color:white;
    text-decoration:none;
    text-align:center;
    cursor:pointer;
    font-size:16px;
    margin-top:10px;
}

.main-btn:hover{
    background:#635543;
}

.text-link{
    color:#806c52;
    text-decoration:none;
}

.logout-btn{
    border:0;
    background:#eee8df;
    padding:10px 18px;
    border-radius:12px;
    cursor:pointer;
}


/* =========================
   PAGE HEADER
========================= */

.page-header{
    text-align:center;
    padding:80px 20px 50px;
}

.page-header h1{
    font-size:45px;
    font-weight:500;
    margin-bottom:15px;
}

.page-header p{
    color:#82766a;
}


/* =========================
   WORKSHOP GRID
========================= */

.workshop-grid{
    max-width:1200px;
    margin:auto;
    padding:20px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.workshop-card{
    background:#fffdfa;
    border:1px solid #e8e0d5;
    border-radius:24px;
    overflow:hidden;
}

.workshop-card img{
    width:100%;
    height:260px;
    object-fit:cover;
}

.workshop-card-content{
    padding:25px;
}

.workshop-card-content h2{
    margin-bottom:12px;
}

.workshop-card-content p{
    color:#81766b;
    line-height:1.8;
    margin-bottom:12px;
}

.workshop-card-content strong{
    display:block;
    color:#806b4f;
    margin-bottom:18px;
}


/* =========================
   WORKSHOP DETAIL
========================= */

.workshop-detail{
    max-width:1100px;
    margin:60px auto;
    background:#fffdfa;
    border-radius:30px;
    overflow:hidden;
    border:1px solid #e8e0d5;
}

.workshop-detail > img{
    width:100%;
    height:450px;
    object-fit:cover;
}

.workshop-detail-content{
    padding:45px;
}

.workshop-detail-content h1{
    font-size:45px;
    margin:12px 0 20px;
}

.large-text{
    color:#75695e;
    font-size:18px;
    line-height:2;
    max-width:750px;
}

.big-price{
    font-size:25px;
    color:#806b4f;
}


/* =========================
   DASHBOARD
========================= */

.dashboard{
    max-width:1200px;
    margin:auto;
    padding:60px 25px;
}

.dashboard h1{
    margin-bottom:35px;
}

.stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    margin-bottom:40px;
}

.stats div{
    background:#fffdfa;
    border:1px solid #e8e0d5;
    padding:25px;
    border-radius:20px;
}

.stats strong{
    display:block;
    font-size:32px;
    margin-bottom:8px;
}

.stats span{
    color:#82766a;
}

.dashboard-section{
    background:#fffdfa;
    border:1px solid #e8e0d5;
    padding:30px;
    border-radius:25px;
    margin-bottom:25px;
}

.dashboard-section h2{
    margin-bottom:25px;
}

.booking-card{
    background:#f7f3ed;
    border:1px solid #e9e0d5;
    padding:20px;
    border-radius:17px;
    margin-bottom:12px;
}

.booking-card h3{
    margin-bottom:8px;
}

.booking-card p{
    color:#7d7165;
    margin:6px 0;
}

.booking-card span,
.booking-card strong{
    color:#806b4f;
}


/* =========================
   MOBILE
========================= */

@media(max-width:800px){

    .workshop-grid{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .workshop-detail{
        margin:20px;
    }

    .workshop-detail > img{
        height:280px;
    }

    .workshop-detail-content{
        padding:25px;
    }

    .workshop-detail-content h1{
        font-size:34px;
    }

    .auth-card{
        padding:25px;
    }

}
